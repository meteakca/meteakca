<div class="blog-listing">
<% for (const item of items) { %>
<a href="<%= item.path %>" class="blog-item">
  <span class="blog-date"><%= item.date ? new Date(item.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) : '' %></span>
  <span class="blog-main"><span class="blog-title"><%= item.title %></span><span class="blog-desc"><%= item.description || '' %></span></span>
  <span class="blog-mark"><% if (item.image) { %><img src="<%= item.image %>" alt=""><% } %></span>
</a>
<% } %>
</div>
